            self.query_one("#status-panel", StatusPanel).refresh_status()
        except NoMatches:
            pass

    def action_run_job(self, name: str) -> None:
        job = load_jobs().get(name)
        if not job:
            self._log(f"[red]No job data for {name} (is the stack running?)[/red]")
            return
        label = JOB_LABELS.get(name, name)
        self._log(f"[bold yellow]▶ Triggering {label} sweep…[/bold yellow]")
        threading.Thread(target=self._do_run, args=(job["id"], label), daemon=True).start()

    def _do_run(self, job_id: str, label: str) -> None:
        result = subprocess.run(
            ["hermes", "cron", "run", job_id],
            capture_output=True, text=True,
        )
        msg = result.stdout.strip() or result.stderr.strip()
        self.call_from_thread(self._log, f"[cyan]{label}: {msg}[/cyan]")

    def _log(self, msg: str) -> None:
        try:
            self.query_one("#live-log", RichLog).write(msg)
        except NoMatches:
            pass

    def action_switch_tab(self, tab_id: str) -> None:
        try:
            self.query_one("#tabs", TabbedContent).active = tab_id
        except NoMatches:
            pass

    def action_open_live_view(self) -> None:
        try:
            self.query_one("#browser-panel", BrowserPanel).open_live_view()
        except NoMatches:
            pass

    def on_button_pressed(self, event: Button.Pressed) -> None:
        if event.button.id == "btn-start":
            self.action_start_stack()
        elif event.button.id == "btn-stop":
            self.action_stop_stack()
        elif event.button.id == "btn-pause":
            self.action_toggle_pause()
        elif event.button.id == "btn-quit":
            self.exit()

    def action_toggle_pause(self) -> None:
        jobs = load_jobs()
        if not jobs:
            self._log("[red]No job data — is the stack running?[/red]")
            return
        # If any job is scheduled (not paused), pausing wins; otherwise resume all.
        any_active = any(j.get("state") != "paused" for j in jobs.values())
        verb = "pause" if any_active else "resume"
        threading.Thread(target=self._do_toggle_pause, args=(jobs, verb), daemon=True).start()

    def _do_toggle_pause(self, jobs: dict, verb: str) -> None:
        for name, job in jobs.items():
            subprocess.run(["hermes", "cron", verb, job["id"]], capture_output=True)
        self.call_from_thread(self._log, f"[cyan]{verb}d all jobs[/cyan]")
        self.call_from_thread(self._refresh_status)

    def action_start_stack(self) -> None:
        self._log("[bold yellow]▶ Starting Good-Guy-Economy stack…[/bold yellow]")
        threading.Thread(target=self._do_stack_cmd, args=("start",), daemon=True).start()

    def action_stop_stack(self) -> None:
        self._log("[bold yellow]⏻ Stopping Good-Guy-Economy stack…[/bold yellow]")
        threading.Thread(target=self._do_stack_cmd, args=("stop",), daemon=True).start()

    def _do_stack_cmd(self, verb: str) -> None:
        services = STACK_SERVICES if verb == "start" else list(reversed(STACK_SERVICES))
        for svc in services:
            result = subprocess.run(
                ["systemctl", "--user", verb, f"{svc}.service"],
                capture_output=True, text=True,
            )
            if result.returncode != 0:
                err = (result.stderr or result.stdout).strip()
                self.call_from_thread(self._log, f"[red]{svc}: {err}[/red]")
            else:
                self.call_from_thread(self._log, f"[green]{svc} {verb}ed[/green]")
        if verb == "stop":
            # hermes-gateway exits 1 on SIGTERM (cosmetic, and it self-rewrites its
            # own unit file so a SuccessExitStatus fix in the unit won't stick).
            subprocess.run(
                ["systemctl", "--user", "reset-failed", "hermes-gateway.service"],
                capture_output=True,
            )
        self.call_from_thread(self._refresh_status)


