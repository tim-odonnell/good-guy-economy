[Unit]
Description=Build the US-economy report at 04:30 (after the 03:40 fact check) and again at 06:40 as a backup

[Timer]
OnCalendar=*-*-* 04:30:00
OnCalendar=*-*-* 06:40:00
# Persistent removed 2026-10-16: a missed run must be skipped, not replayed at boot (no night = no report)
# wake from suspend so the report is built even if the machine was put to sleep during the window
WakeSystem=true

[Install]
WantedBy=timers.target
