#!/usr/bin/env python3
"""econ-fetch — fetch a web page / feed / CSV / JSON and print SHORT readable text.

Built for Good-Guy-Economy (US economy topic) so a raw 200 KB HTML page never floods the
model's context. Stdlib only.

  econ-fetch URL                      # readable text, first 3000 chars
  econ-fetch URL --grep unemployment  # only lines containing the word (+ neighbours)
  econ-fetch URL --max 6000           # more text
  econ-fetch URL --links tariff       # list links whose text/URL contains the word

Handles HTML (strips menus/scripts), RSS/Atom (title · date · link per item),
JSON (compact), CSV (header + last rows), PDF (via pdftotext if installed).
First line is always a STATUS line. If it says BLOCKED, you did NOT get the data:
log it in wanted.md and use another source or the browser tool.
"""
import argparse
import gzip
import html
import json
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
import xml.etree.ElementTree as ET
from html.parser import HTMLParser

HONEST_UA = "good-guy-economy-research/1.0 (personal economic research; python-urllib)"
UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "
      "Chrome/126.0 Safari/537.36")
BLOCK_SIGNS = ("captcha", "access denied", "just a moment", "are you a robot", "verify you are human",
               "enable javascript and cookies", "request unsuccessful", "unusual traffic",
               "pardon our interruption", "attention required")


def _get(url, ua, timeout):
    req = urllib.request.Request(url, headers={
        **({"User-Agent": ua} if ua else {}), "Accept": "text/html,application/xhtml+xml,application/xml,application/json,text/csv,*/*",
        "Accept-Language": "en-US,en;q=0.9", "Accept-Encoding": "gzip"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read(8_000_000)
            if r.headers.get("Content-Encoding") == "gzip":
                body = gzip.decompress(body)
            return r.status, r.geturl(), r.headers.get("Content-Type", ""), body
    except urllib.error.HTTPError as e:
        body = e.read(200_000) if e.fp else b""
        if e.headers and e.headers.get("Content-Encoding") == "gzip":
            try:
                body = gzip.decompress(body)
            except Exception:
                pass
        return e.code, url, e.headers.get("Content-Type", "") if e.headers else "", body


def get(url, timeout=30):
    """Sites disagree about client names: BLS accepts only an honest custom name, FRED blocks
    that (and browser names) but accepts Python's default. Try names in turn until one works."""
    order = [None, HONEST_UA, UA] if "stlouisfed.org" in url else [HONEST_UA, None, UA]
    res = None
    for ua in order:
        try:
            res = _get(url, ua, timeout)
            if res[0] not in (401, 403, 406, 429):
                return res
        except Exception as e:
            err = e
    if res is None:
        raise err
    return res


class Text(HTMLParser):
    SKIP = {"script", "style", "noscript", "svg", "nav", "footer", "header", "form", "button", "select", "iframe"}
    BLOCK = {"p", "div", "br", "li", "tr", "h1", "h2", "h3", "h4", "h5", "h6", "table", "section", "article", "td", "th", "dt", "dd"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out, self.skip, self.links, self.href, self.title, self.in_title = [], 0, [], None, "", False

    def handle_starttag(self, tag, attrs):
        if tag in self.SKIP:
            self.skip += 1
        if tag in self.BLOCK:
            self.out.append("\n")
        if tag in ("td", "th"):
            self.out.append(" | ")
        if tag == "a":
            self.href, self.atext = dict(attrs).get("href"), []
        if tag == "title":
            self.in_title = True

    def handle_endtag(self, tag):
        if tag in self.SKIP and self.skip:
            self.skip -= 1
        if tag == "a" and self.href:
            self.links.append((" ".join("".join(self.atext).split()), self.href))
            self.href = None
        if tag == "title":
            self.in_title = False

    def handle_data(self, data):
        if self.in_title:
            self.title += data
        if self.skip:
            return
        self.out.append(data)
        if self.href is not None:
            self.atext.append(data)


def html_to_text(raw):
    p = Text()
    p.feed(raw)
    text = "".join(p.out)
    lines = [" ".join(ln.split()) for ln in text.splitlines()]
    lines = [ln for ln in lines if len(ln) > 1]
    return p.title.strip(), "\n".join(lines), p.links


def feed_to_text(raw):
    root = ET.fromstring(raw)
    items = root.findall(".//item") or root.findall(".//{http://www.w3.org/2005/Atom}entry")
    out = []
    for it in items[:40]:
        def f(*names):
            for n in names:
                el = it.find(n)
                if el is not None:
                    return (el.text or el.get("href") or "").strip()
            return ""
        a = "{http://www.w3.org/2005/Atom}"
        link = f('link', a + 'link')
        if "news.google.com/" in link:
            link = ""  # long redirect blobs; the title already ends with the outlet name
        out.append(f"- {html.unescape(f('title', a + 'title'))} · {f('pubDate', a + 'updated', a + 'published')}" + (f" · {link}" if link else ""))
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("url")
    ap.add_argument("--grep", help="show only lines containing this word (case-insensitive), with 1 line around")
    ap.add_argument("--links", metavar="WORD", help="list links whose text or URL contains WORD ('' for all)")
    ap.add_argument("--max", type=int, default=3000, help="max characters to print (default 3000)")
    a = ap.parse_args()

    try:
        status, final, ctype, body = get(a.url)
    except Exception as e:
        print(f"STATUS: FAILED — {type(e).__name__}: {e}. No data; log BLOCKED in wanted.md.")
        sys.exit(2)

    ctype = ctype.lower()
    raw = body.decode("utf-8", "replace")
    kind, title, links = "text", "", []
    head = raw.lstrip()[:300].lower()
    if "pdf" in ctype or body[:4] == b"%PDF":
        kind = "pdf"
        if shutil.which("pdftotext"):
            with tempfile.NamedTemporaryFile(suffix=".pdf") as tf:
                tf.write(body)
                tf.flush()
                text = subprocess.run(["pdftotext", "-layout", tf.name, "-"], capture_output=True, text=True).stdout
        else:
            text = "(PDF — pdftotext not installed; cannot read)"
    elif "json" in ctype or head[:1] in ("{", "["):
        kind = "json"
        try:
            text = json.dumps(json.loads(raw), separators=(",", ":"))
        except Exception:
            text = raw
    elif "xml" in ctype and ("<rss" in head or "<feed" in head or "<?xml" in head) and "<html" not in head:
        kind = "feed"
        try:
            text = feed_to_text(raw) or raw
        except Exception:
            text = raw
    elif "csv" in ctype or (re.match(r"^[\w\"., -]+(,[\w\"., -]+)+\r?\n", raw[:500]) and "<" not in raw[:500]):
        kind = "csv"
        rows = raw.strip().splitlines()
        text = rows[0] + "\n...\n" + "\n".join(rows[-15:]) if len(rows) > 17 else "\n".join(rows)
        text += f"\n({len(rows) - 1} data rows; showing the last 15)"
    elif "html" in ctype or "<html" in head or "<!doctype" in head:
        kind = "html"
        title, text, links = html_to_text(raw)
    else:
        text = raw

    low = (title + " " + text[:3000]).lower()
    blocked = status >= 400 or any(s in low for s in BLOCK_SIGNS)
    js_only = kind == "html" and len(text) < 400
    verdict = ("BLOCKED" if blocked else "JS-ONLY (page needs the browser tool)" if js_only else "OK")
    print(f"STATUS: {verdict} · HTTP {status} · {kind} · {len(text)} chars · {final}" + (f" · title: {title[:80]}" if title else ""))
    if blocked:
        print("You did NOT get this page's data. Log `BLOCKED: <url>` in wanted.md; try another source or the browser tool.")
        sys.exit(1)

    if a.links is not None:
        w = a.links.lower()
        seen = set()
        from urllib.parse import urljoin
        for t, h in links:
            full = urljoin(final, h)
            if (w in t.lower() or w in full.lower()) and full not in seen and t:
                seen.add(full)
                print(f"- {t[:90]} -> {full}")
                if len(seen) >= 40:
                    break
        return

    if a.grep:
        w = a.grep.lower()
        lines = text.splitlines()
        keep = sorted({j for i, ln in enumerate(lines) if w in ln.lower() for j in (i - 1, i, i + 1) if 0 <= j < len(lines)})
        text = "\n".join(lines[i] for i in keep) or f"(no line contains '{a.grep}')"

    if len(text) > a.max:
        text = text[:a.max] + f"\n[... cut at {a.max} chars of {len(text)}; use --grep WORD or --max N]"
    print(text)


if __name__ == "__main__":
    main()
