# Good-Guy-Economy's model (since 2026-10-09): Unsloth E2B (official Google weights, QAT, UD-Q4_K_XL) + vision +
# reasoning, run by gemma12b-run from good-guy-economy-llm.service. Copy of good-guy-economy-huihui-think.env with only the
# model, mmproj and label changed (user's request: try the non-abliterated E2B for tool use).
GEMMA_ENGINE_SRC=$HOME/ubu/engine/llama-b10622
GEMMA_MODEL=$HOME/ubu/models/gemma-4-e2b/gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf
GEMMA_DRAFT=$HOME/ubu/models/gemma-4-e2b/mtp-gemma-4-E2B-it.gguf
GEMMA_LABEL="Good-Guy-Economy (Unsloth E2B)"
# Different: Good-Guy-Economy's fixed endpoint. hermes (model.default good-guy-economy-llm, base_url :8099) needs no change.
GEMMA_ALIAS=good-guy-economy-llm
GEMMA_PORT=8099
GEMMA_THREADS=4

# Different: 65536 = hermes-agent's 64,000 floor, matches hermes model.context_length
# (good-guy-economy-apply-model keeps them in sync). E2B could do 131072.
GEMMA_CTX=65536

GEMMA_MTP=on
GEMMA_MTP_N_MAX=3
GEMMA_MTP_P_MIN=0.9

# Different: reasoning on (user's request 2026-10-05).
GEMMA_THINKING=on
GEMMA_THINKING_BUDGET=1024

# Vision, as in e2b-huihui.env.
GEMMA_MMPROJ=$HOME/ubu/models/gemma-4-e2b/mmproj-F16.gguf
GEMMA_BATCH=2048
GEMMA_UBATCH=2048
GEMMA_IMAGE_MAX_TOKENS=1120
GEMMA_N_PREDICT=8192
# Gate measured for e2b-huihui at 131072 ctx with a picture (peak 5,360); 65536 is smaller, so this is safe.
GEMMA_NEED_MIB=5700

# Different (2026-10-05): prompt cache, so Hermes' side requests (vision_analyze, titles) don't
# throw away the agent's conversation. Measured before the fix: one image step cost a full
# 14k-token re-read (~13 min). The cache holds slot states up to this many MiB.
GEMMA_CACHE_RAM=1024
